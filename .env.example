# Copy to .env.local. Keep real credentials out of Git.
# Browser-safe values (publishable key only):
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only PostgreSQL connection string from Supabase Dashboard > Connect.
# Use the pooler connection string if your network requires IPv4.
# NEVER prefix this with VITE_ and never expose it to browser code.
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
CLIENT_URL=http://localhost:5173
NODE_ENV=development
PORT=4000
