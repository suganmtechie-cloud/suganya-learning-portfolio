rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can access only their own pathway documents.
    match /users/{userId}/pathways/{pathwayId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.ownerId == userId
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 80
        && request.resource.data.audience is string
        && request.resource.data.audience.size() <= 100
        && request.resource.data.outcome is string
        && request.resource.data.outcome.size() <= 240
        && request.resource.data.durationHours is int
        && request.resource.data.durationHours >= 1
        && request.resource.data.durationHours <= 40
        && request.resource.data.modules is list
        && request.resource.data.modules.size() <= 12;
    }

    // Deny access to all other documents until an explicit feature rule is added.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
